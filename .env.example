# ============================================================
# INSTAGRAM FEED WIDGET - Variáveis de Ambiente
# ============================================================
# Copie para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env no GitHub!
# ============================================================

# ------------------------------------------------------------
# INSTAGRAM / META API (obrigatório)
# ------------------------------------------------------------
# Access Token de longa duração gerado no Meta for Developers
# Como gerar: veja o README, seção "Configurando o Instagram"
INSTAGRAM_ACCESS_TOKEN=IGQVJ...

# ID numérico da conta Instagram Business/Creator
INSTAGRAM_USER_ID=17841400000000000

# Versão da API do Instagram
INSTAGRAM_API_VERSION=v21.0

# ------------------------------------------------------------
# CACHE E SINCRONIZAÇÃO
# ------------------------------------------------------------
# Tempo em segundos que o cache do feed é mantido
CACHE_DURATION=1800

# Quantos posts buscar por vez em cada página da API
# (a API do Instagram permite até 100, mas 25 é o padrão seguro)
INSTAGRAM_PAGE_SIZE=25

# Máximo de posts a armazenar no cache (0 = ilimitado)
# Não é limitação da API, é só proteção de memória
STORAGE_MAX_POSTS=500

# Quantas páginas buscar em cada sincronização
# (evita estourar rate limit em sincronizações iniciais)
SYNC_MAX_PAGES=10

# ------------------------------------------------------------
# ARMAZENAMENTO PERSISTENTE (opcional)
# ------------------------------------------------------------
# Por padrão, o sistema usa cache em memória (funciona bem em produção)
# Se quiser persistência real, configure Upstash Redis:
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Domínios permitidos. Use "*" para todos (dev) ou liste separados por vírgula
ALLOWED_ORIGINS=*

# ------------------------------------------------------------
# ADMIN
# ------------------------------------------------------------
# Chave para acessar endpoints administrativos
# Gere com: openssl rand -hex 32
ADMIN_API_KEY=troque_por_chave_secreta_longa

# ------------------------------------------------------------
# AMBIENTE
# ------------------------------------------------------------
NODE_ENV=production
